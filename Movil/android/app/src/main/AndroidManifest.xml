<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Notificación media (audio_service): foreground service de reproducción -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Descubrimiento de Chromecasts en la red local (Google Cast nativo) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Cast Local (LAN + PIN): recibir beacon UDP de la TV en la misma red -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <application
        android:label="Auris TV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name="com.auristv.oficial.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:supportsPictureInPicture="true"
            tools:targetApi="24"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep Link Intent Filter for AurisTV QR Activation -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="auristv"/>
                <data android:host="activate"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="auristv.dpdns.org"/>
                <data android:pathPrefix="/activate"/>
            </intent-filter>
            <!-- Deep Links para Anime, Series y Películas (WhatsApp / Web / Enlaces compartidos) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="auristv.dpdns.org" android:pathPrefix="/anime"/>
                <data android:scheme="https" android:host="auristv.dpdns.org" android:pathPrefix="/serie"/>
                <data android:scheme="https" android:host="auristv.dpdns.org" android:pathPrefix="/series"/>
                <data android:scheme="https" android:host="auristv.dpdns.org" android:pathPrefix="/movie"/>
                <data android:scheme="https" android:host="auristv.dpdns.org" android:pathPrefix="/detalles"/>
                <data android:scheme="http" android:host="auristv.dpdns.org" android:pathPrefix="/anime"/>
                <data android:scheme="http" android:host="auristv.dpdns.org" android:pathPrefix="/serie"/>
                <data android:scheme="http" android:host="auristv.dpdns.org" android:pathPrefix="/series"/>
                <data android:scheme="http" android:host="auristv.dpdns.org" android:pathPrefix="/movie"/>
                <data android:scheme="http" android:host="auristv.dpdns.org" android:pathPrefix="/detalles"/>
            </intent-filter>
            <!-- Esquema personalizado auristv:// para enlaces directos -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="auristv" android:host="anime"/>
                <data android:scheme="auristv" android:host="serie"/>
                <data android:scheme="auristv" android:host="series"/>
                <data android:scheme="auristv" android:host="movie"/>
                <data android:scheme="auristv" android:pathPrefix="/anime"/>
                <data android:scheme="auristv" android:pathPrefix="/serie"/>
                <data android:scheme="auristv" android:pathPrefix="/series"/>
                <data android:scheme="auristv" android:pathPrefix="/movie"/>
            </intent-filter>
            <!-- Deep Link de Google OAuth (Supabase signInWithOAuth): el
                 redirectTo `io.supabase.flutter://callback` regresa aquí y
                 el DeepLinkHandler (app_links) completa la sesión. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.flutter"/>
            </intent-filter>
        </activity>
        <!-- Override de flutter_appauth: el plugin registra su
             RedirectUriReceiverActivity con ${appAuthRedirectScheme}. El
             placeholder apuntaba a `io.supabase.flutter` y duplicaba el
             claim del scheme con MainActivity (popup "Abrir con"): AppAuth
             solo serve AniList/Simkl, cuyo redirect es `auristv://auth`. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            tools:node="replace"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="auristv"/>
                <data android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Google Cast nativo (Chromecast): proveedor de opciones del SDK -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.auristv.oficial.CastOptionsProvider" />

        <!-- Servicio de notificación media (audio_service): permite controlar
             la reproducción desde el shade / lock screen / Bluetooth. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Comparte el APK descargado con el instalador del sistema (actualizaciones in-app) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
